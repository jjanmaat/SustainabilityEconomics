<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="true">
  <code><![CDATA[;; Landscape with water and land.  
;; Fish live in the water, reproducing according to standard logistic growth 
;; Land produces grain.  Grain must be gathered from patches.
;;
;; A couple is set up with a house somewhere on land.
;; There are two types that make up the couple, a gatherer and a hunter
;; The gatherer will have a comparative advantage in gathering
;; The hunter will have a comparative advantage in hunting - which here is fishing
;; The people need to consume a combination of fish and grain each tick to survive
;; Each type carries an inventory of fish and grain that they consume from each tick
;; The house has an inventory of fish and grain that the people contribute to and draw from
;; There will be a threshold level for the house inventory that triggers movement to gather or hunt

patches-own [ zone harvest-max since-harvest grain]
breed [ fish a-fish ]
breed [ people person ]
people-own [
  ;; Energy requirements
  myEnergy       ;; storage for energy
  myEnergyMax    ;; maximum energy that can be stored
  myEnergyTick   ;; basic energy needed to survive a tick
  myEnergyMove   ;; energy needed for each step moved
  myEnergyFish   ;; energy needed per fish harvested
  myEnergyGrain  ;; energy needed per unit of grain harvested
  ;; myEnergyForFish;; share of energy that is devoted to fishing
  ;; Fish parameters
  myFish         ;; fish person holds
  myFishMax      ;; maximum number of fish that can be held
  myFishEnergy   ;; energy gain per fish consumed
  myFishNet      ;; patches in fishing net
  myFishNetRadius;; radius of fish net
  ;; Grain parameters
  myGrain        ;; grain person holds
  myGrainMax     ;; maximum units of grain that can be held
  myGrainEnergy  ;; energy gain per unit of grain consumed
  ;; Other parameters
  myMaxSteps     ;; maximum number of movement steps per tick
  myVillage         ;; village person is attached to
  myJob          ;; job person has - fish harvester or grain gatherer
  myJobTime      ;; time left for current job
  myJobFishShare ;; share of day that goes to fishing
  myLeisureTicks ;; sum of ticks when at home and not being sent out 
  goHome         ;; flag to indicate person is headed home
]
breed [ villages village ]
villages-own [
  ourFish        ;; fish in village inventory
  ourFishMax     ;; maximum fish inventory to hold
  ourGrain       ;; grain inventory in village
  ourGrainMax    ;; maximum grain inventory to hold
  ourPeople       ;; people attached to this village
]

;; Setup global variables
globals [
  ;; carrying capacity follows a triangle distribution
  ;; fish-carrying-capacity-mu    ;; mean of fish carrying capacity
  ;; fish-carrying-capacity-rng   ;; range for fish carrying capacity distribution
  ;; fish-growth-rate
  ;; fish-tick-move-distance
  ;; land patch yield follows a triangle distribution
  ;; land-yield-mu                ;; mean of land yield
  ;; land-yield-rng               ;; range for land yield
  ;; land-yield-maturity-ticks    ;; ticks till land is mature after harvest
  ;; invent-fish-decay-mu         ;; mean decay rate for fish held in village inventory
  ;; invent-fish-decay-rng
  ;; invent-grain-decay-mu
  ;; invent-grain-decay-rng
  ;; invent-min-fish-ticks
  ;; invent-min-grain-ticks
  ;; people-max-steps
  ;; fish-net-radius-mu
  ;; fish-net-radius-rng
  ;; fish-take-step-cost-mu
  ;; fish-take-step-cost-rng
  clock
  maxClock
]

;; set default values
to defaults
  set-globals
end

;; Set values for globals
to set-globals 
  ;; set up fish ecology
  set fish-carrying-capacity-mu 200
  set fish-carrying-capacity-rng 0
  set fish-growth-rate 0.1
  set fish-tick-move-distance 2
  ;; set up land ecology
  set land-yield-mu 5
  set land-yield-rng 0
  set land-yield-maturity-ticks 10
  ;; set defaults for fisher
  set fisher-max-steps 5
  set fisher-grain-step-cost-mu 0.67
  set fisher-grain-step-cost-rng 0
  set fisher-fish-net-radius-mu 10
  set fisher-fish-net-radius-rng 0
  set fisher-fish-take-step-cost-mu 0.33
  set fisher-fish-take-step-cost-rng 0
  set fisher-fish-max-carry 30
  set fisher-grain-max-carry 100
  set fisher-fish-step-eat 1
  set fisher-grain-step-eat 5
  set fisher-min-rest-ticks 18
  ;; set defaults for gatherer
  ;; set gather-max-steps 5
  ;; set gather-grain-step-cost-mu 0.33
  ;; set gather-grain-step-cost-rng 0
  ;; set gather-fish-net-radius-mu 5
  ;; set gather-fish-net-radius-rng 0
  ;; set gather-fish-take-step-cost-mu 0.67
  ;; set gather-fish-take-step-cost-rng 0
  ;; set gather-fish-max-carry 20
  ;; set gather-grain-max-carry 200
  ;; set gather-fish-step-eat 1
  ;; set gather-grain-step-eat 5
  ;; set gather-min-rest-ticks 18
  ;; set village defaults
  ;; set invent-min-fish-ticks 10
  ;; set invent-min-grain-ticks 10
  ;; set village-population 2
  ;; set village-share-fishing 0.5
  ;; set up inventory decay parameters
  set invent-fish-decay-mu 0
  set invent-fish-decay-rng 0
  set invent-grain-decay-mu 0
  set invent-grain-decay-rng 0
  ;; parameters specifying how many ticks worth of inventory desired in village
  ;; set invent-min-fish-ticks 10
  ;; set invent-min-grain-ticks 10
end

;; random draw from triangle distribution
to-report random-triangle [ 
  mu          ;; mean
  rng         ;; base width of triangle
]
  report mu + rng * (random-float 0.5 - random-float 0.5)
end

;; Setup

to setup
  clear-all
  clear-all-plots
  ;; set dimensions of world
  resize-world 0 50 0 50
  ;; set-globals ;; set global values
  ask patches [
    ifelse pxcor < 30
    [
      set zone "Land" 
      ;; set pcolor green
      set harvest-max 10
      set since-harvest land-yield-maturity-ticks
      set grain random-triangle land-yield-mu (land-yield-rng * land-yield-mu)
      let colorAdj 0
      if land-yield-rng > 0 [
        set colorAdj round((land-yield-mu - grain) / (2 * land-yield-rng * land-yield-mu)) * 2
        show (word "grain: " grain ", colorAdj: " colorAdj) 
      ]
      set pcolor 55 + colorAdj
    ]
    [
      set zone "Water" 
      set pcolor blue
      set harvest-max 0
    ]
  ]
  ;; initialize fish population
  setup-fish fish-carrying-capacity-mu / 2
  reset-ticks
  setup-villages
  ;; set the clock
  set clock 0
  set maxClock 12
  show "Done Setup"
end

;; get harvester location
to setup-villages
  ;; check that location is on land, and that this village is not located in the same place
  ;; as another village
  let count-of-homes 1
  create-villages count-of-homes [
    ;; First thing is placing the village.  This is done for each village.  If placement is user 
    let newPlace one-of patches with [ zone = "Land" ]
    ;; doing the random placement
    let placed false
    while [not placed] [
      ifelse not ((any? (([neighbors] of newPlace) with [ zone = "Water" ])) or (any? villages-on newPlace)) [
        set placed true
      ]
      [
        ;; get a new random patch
        set newPlace one-of patches with [ zone = "Land" ]
      ]
    ]
    ;; got a place that works.  Now set up the village
    move-to newPlace
    set shape "house"
    set color yellow
    ;; clear out grain in spot where village is
    ask newPlace [ set grain 0 ]
    ;; set village starting values
    ;; set ourMinFishTicks 10
    ;; set ourMinGrainTicks 10
    ;; create people and add them to the village
    let parent self
    set ourPeople []
    let family-size 1
    hatch family-size [
      set breed people
      move-to newPlace
      set shape "person"
      set color red
      set myVillage parent
      ask parent [ 
        set ourPeople (turtle-set ourPeople myself) 
      ]
      ;; set energy related parameters for people
      set myEnergy 1000      ;; storage for energy
      set myEnergyMax 1000   ;; maximum energy that can be stored
      set myEnergyTick 20   ;; basic energy needed to survive a tick
      set myEnergyMove 5   ;; energy needed for each step moved
      set myEnergyFish 2  ;; energy needed per fish harvested
      set myEnergyGrain 0.25  ;; energy needed per unit of grain harvested
      ;; set myEnergyForFish 0.5 ;; share of energy that is devoted to fishing
                              ;; Fish parameters
      set myFish 0         ;; fish person holds
      set myFishMax 30     ;; maximum number of fish that can be held
      set myFishEnergy 10   ;; energy gain per fish consumed
      set myFishNet no-patches     ;; patches in fishing net
      set myFishNetRadius 10 ;; radius of fish net
                             ;; Grain parameters
      set myGrain 0       ;; grain person holds
      set myGrainMax 120     ;; maximum units of grain that can be held
      set myGrainEnergy 2  ;; energy gain per unit of grain consumed
                             ;; further parameters
      set myJobFishShare 0.5
      set myMaxSteps 4
      set myLeisureTicks 0
      ;; set fishing characteristics
      set goHome true
    ]
    ;; set up the initial inventory
    set ourFish 0
    set ourFishMax 200
    set ourGrain 0
    set ourGrainMax 1000
  ]
end

;; set fish numbers in water
to setup-fish [ n-fish ]
  create-fish n-fish [
    set shape "fish"
    set color red
    move-to one-of patches with [ zone = "Water" ]
    set heading random-float 360
  ]
end

;;***************************************************************************************************************
;; Go
to go
  move-fish 
  grow-fish
  grow-grain
  eat
  ;; go over every person
  ask villages [
    in-village self
    ask ourPeople with [ myJob = "Fi" ][ harvest-fish self ]
    ask ourPeople with [ myJob = "Ga" ][ gather-grain self ]
  ]
  ;; advance the clock, reset if hits max time
  set clock clock + 1
  if clock > maxClock [ set clock 0 ]
  tick
end
;;
;;**************************************************************************************************************


;; 
;; do activity at home
;; if at home, adjust inventory so each person is holding inventory would start with if 
;; leaving on activity
;; check if number of ticks of village inventory less than resting ticks.  If it is, send 
;; out people who are at home for inventory with least ticks
to in-village [ thisHome ]
  show "In Village"
  ;; Once per day everyone should be home.  This occurs when the clock is zero.
  ;; At this time, when the clock is zero, do the trading.
  ask thisHome [
    ;; check if nobody left alive
    if count ourPeople = 0 [
      set color black
    ]
    ;; get all people who are at home
    let peopleHere ourPeople with [
      patch-here = [patch-here] of thisHome
    ]
    ;; check to see if it is market time.  Market time occurs when the clock gets to 12
    if clock = maxClock [
      show "End of Day"
      ;; market time.  Check if everybody is home
      if not ((count peopleHere) = (count ourPeople)) [
        show (word "ERROR #peopleHere:" count peopleHere " #myPeople:" count ourPeople)
      ]
      ;; for everyone here, put the fish and grain into the inventory.  This is done at end of day
      ;; keep inventory for self during the day.
      set ourFish sum [myFish] of peopleHere 
      set ourGrain sum [myGrain] of peopleHere
      ask peopleHere [
        set myFish 0
        set myGrain 0
      ]
      ;; at home and at maxClock, time to eat and increase energy
      ;; leave behind in inventory what is not needed
      let flag true
      while [flag] [
        ;; loop over consuming food, one energy unit at a time, distributing over all people here until
        ;; either all usable inventory gone, or nobody can increase their energy further
        set flag false
        ask peopleHere with [myEnergy < myEnergyMax] [
          ;; get the fish and grain taken
          let takeFish min (list (1 / myFishEnergy) [ourFish] of myself)
          let takeGrain min (list (1 / myGrainEnergy) [ourGrain] of myself)
          show (word "takeFish:" takeFish " takeGrain:" takeGrain)
          ;; get the energy increase that can be provided by the fish and energy
          let myEnergyAdd min (list (takeFish * myFishEnergy) (takeGrain * myGrainEnergy) (myEnergyMax - myEnergy))
          show (word "myEnergyAdd:" myEnergyAdd)
          if myEnergyAdd > 0 [
            set myEnergy myEnergy + myEnergyAdd
            ;; reduce the inventory
            set takeFish myEnergyAdd * myFishEnergy
            set takeGrain myEnergyAdd * myGrainEnergy
            ask myVillage [
              set ourFish ourFish - takeFish
              set ourGrain ourGrain - takeGrain
            ]
            set flag true
          ]
        ]
      ]
    ]
    ;; decay the fish and the grain
    ;; decay based on triangle distribution, where one end of distribution is no decay
    let fishDecay random-triangle invent-fish-decay-mu ((min list invent-fish-decay-mu ( 1 - invent-fish-decay-mu)) * invent-fish-decay-rng )
    set ourFish ourFish * (1 - fishDecay)
    let grainDecay random-triangle invent-grain-decay-mu ((min list invent-grain-decay-mu ( 1 - invent-grain-decay-mu)) * invent-grain-decay-rng )
    set ourGrain ourGrain * (1 - grainDecay)
    ;; 
    ;; Figure out what I am going to do now.
    ;; if own inventory is zero, choose job at random.  Otherwise, choose job based on relative inventory
    ask peopleHere [
      if (myFish < myFishMax) or (myGrain < myGrainMax) [
        show "Setting job"
        set goHome false
        ;; have capacity to harvest or gather more, figure out what to do
        ifelse (myFish = 0) and (myGrain = 0) [
          ;; inventory zero, pick one of the two jobs
          set myJob one-of ["Fi" "Ga"]
        ]
        [
          ifelse (myFish < myFishMax) and (myGrain < myGrainMax) [
            ;; have some inventory
            ifelse (myFish / myEnergyFish) > (myGrain / myEnergyGrain) [
              ;; energy value of fish in possession more than of grain, go for grain
              set myJob "Ga"
            ]
            [
              set myJob "Fi"
            ]
          ]
          [
            ifelse (myFish < myFishMax) [
              set myJob "Fi"
            ]
            [
              set myJob "Ga"
            ]
          ]
        ]
        ;; now set the time for the task
        ifelse myJob = "Fi" [
          set myJobTime (min list (maxClock * myJobFishShare) (maxClock - clock)) - 1
        ]
        [
          set myJobTime (min list (maxClock * (1 - myJobFishShare)) (maxClock - clock)) - 1
        
        ]
      ]
    ]
  ]
end

;; eat-food
;; each tick, people need to eat.  Amount need to eat set as owned variables 
to eat
  ask villages [
    ask ourPeople [
      set myEnergy myEnergy - myEnergyTick
      if myEnergy < 0 [die]
      set myJobTime max list (myJobTime - 1) 0
    ]
  ]
end

;; harvest fish
;; each fish caught takes a time step.  Throwing the net takes one step.
to harvest-fish [ thisPerson ]
  show "harvest-fish"
  ask thisPerson [
    ;; is it time to head home?
    let timeHome time-to-village self
    if ((not (myFish < myFishMax)) or (not (timeHome < floor (maxClock - clock))) or (not (timeHome < floor myJobTime))) [
      set goHome true
      ;; if going home, pull net if not already pulled
      if any? myFishNet [
        ask myFishNet [set pcolor blue]
        set myFishNet no-patches
        show "Pulling net"
      ]
      move-toward-village self
    ]
    ;
    ifelse not goHome [
      ;
      ifelse any? (neighbors with [ zone = "Water" ]) [
        ;; if necessary, cast the net
        if not any? myFishNet [
          ;; get the closest water patch
          let netCenter min-one-of patches with [ zone = "Water" ][distance thisPerson]
          ;; cast the net
          set myFishNet ([patches in-radius ([myFishNetRadius] of thisPerson)] of netCenter) with [ zone = "Water" ]
          ask myFishNet [set pcolor cyan]
        ]          
        ;; pull as many fish out of the net as possible
        let inNet fish-on myFishNet
        let caughtFish up-to-n-of (myFishMax - myFish) inNet
        set myFish MyFish + count caughtFish
        set myEnergy myEnergy - (count caughtFish * myFishEnergy)
        ask caughtFish [ die ]
        show "Hauling in fish"
      ]
      [
        ;; no water in neighbourhood, so move toward shore
        move-toward-shore self
      ]
    ]
    [
      move-toward-village self
    ]
  ]
end

;;
;; distance to shore
to-report time-to-shore [ thisPerson ]
  let dist 0
  ask thisPerson [
    let shore min-one-of patches with [ zone = "Water" ][distance thisPerson]
    set dist (distance shore) / myMaxSteps
  ]
  report dist
end
;;
;; distance to nearest grain
to-report time-to-grain [ thisPerson ]
  let dist 0
  ask thisPerson [
      let nearGrain min-one-of patches with [ grain > 0][distance thisPerson]
    set dist (distance nearGrain) / myMaxSteps
  ]
  report dist
end
;;
;; distance to village
to-report time-to-village [ thisPerson ]
  let dist 0
  report ([distance myVillage] of thisPerson) / myMaxSteps
end

;; 
;; move a person agent toward shore
to move-toward-shore [ thisPerson ]
  show "move-toward-shore"
  ask thisPerson [
    if not any? (neighbors with [ zone = "Water" ]) [
      ;; get closest water patch
      let shore min-one-of patches with [ zone = "Water" ][distance thisPerson]
      if shore != nobody [
        face shore
        let steps-moved 0
        ;; move step by step until neighbour is water
        while [ steps-moved < myMaxSteps and not any? (neighbors with [ zone = "Water" ])] [
          fd 1
          set steps-moved steps-moved + 1
          set myEnergy myEnergy - myEnergyMove
          if myEnergy < 0 [ die ]
          ;; should not be in the water, but might accidentally be
          if patch-here = shore [
            stop
          ]
        ]
      ]
    ]
  ]
end

;; move a person agent toward the house
to move-toward-village [ thisPerson ]
  show "move-toward-village"
  ask thisPerson [
    ;; are we at the house?
    ifelse [patch-here] of thisPerson != [patch-here] of myVillage [
      ;; not at the house, so move toward house
      face myVillage
      let steps-moved 0
      while [ steps-moved < myMaxSteps and ([patch-here] of thisPerson != [patch-here] of myVillage)] [
        fd 1
        set steps-moved steps-moved + 1
        set myEnergy myEnergy - myEnergyMove
        if myEnergy < 0 [ die ]
      ]
    ]
    [
      ;; at the village
      
    ]
  ]
end
  
;; move toward gathering spot
;; move in direction of neighborhood with the most food
;; move just one step.  This is called from the gathering process
to move-toward-grain [ thisPerson ]
  show "move-toward-grain"
  ask thisPerson [
    if [grain] of patch-here = 0 [
      ;; find nearest patch with grain
      let nearGrain min-one-of patches with [ grain > 0][distance thisPerson]
      face nearGrain
      let steps-moved 0
      while [([grain] of patch-here = 0) and (steps-moved < myMaxSteps)] [
        ;; no grain here, so move toward nearest patch with grain
        fd 1
        set steps-moved steps-moved + 1
        set myEnergy myEnergy - myEnergyMove
        if myEnergy < 0 [ die ]
      ]
    ]
  ]
end

;;
;; gather grain from a patch
to gatherPatch [ thisPerson thisPatch ]
  ask thisPerson [
    let toHarvest min list ([grain] of thisPatch) (myGrainMax - myGrain)
    set myGrain myGrain + toHarvest
    set myEnergy myEnergy - toHarvest * myEnergyGrain
    ask thisPatch [
      set grain grain - toHarvest
      if grain = 0 [
        set since-harvest 0
        set pcolor brown
      ]
    ]
  ]
end
;;
;; gather grain
;; gather grain proceeds by moving in the direction of grain until finding a patch with grain.
;; movement and harvesting continue until max step reached.  Each harvest counts as a step, as 
;; well as movement.
to gather-grain [ thisPerson ]
  show "gather-grain"
  ask thisPerson [
    ;; go home if have hit max capacity for grain, only have enough time left in day to 
    ;; go home, or only have enough time left in time for this activity to get home
    let timeHome time-to-village self
    if ((not (myGrain < myGrainMax)) or (not (timeHome < ceiling (maxClock - clock))) or (not (timeHome < ceiling myJobTime))) [
      set goHome true
    ]
    ;; check if going home
    ifelse goHome [
      move-toward-village self
    ]
    [
      if [grain] of patch-here > 0 [
        ;; gather as much as possible, first from patch on, then from neighbours 4
        gatherPatch self patch-here
        if myGrain < myGrainMax [
          ;; still have space to harvest more
          let harvestPatches ( patch-set patch-here neighbors4 )
          ask harvestPatches [ gatherPatch myself self ]
        ]
      ]
      ;; move toward grain
      move-toward-grain self
    ]
  ]
end

;; move fish
to move-fish
  ;; do a somewhat random walk for fish
  let fish-step fish-tick-move-distance
  ask fish [
    let ahead patch-ahead fish-step
    let flag true 
    while [flag] [
      if ahead != nobody [ 
        if [zone] of ahead = "Water" [
          set flag false
        ]
      ]
      let myDirection heading
      if flag [
        set myDirection myDirection + 150 + random-float 60
      ]
      set heading myDirection + random-float 45 - 22.5
      set ahead patch-ahead fish-step
    ]
    forward fish-step
  ]
end

;; grow fish
to grow-fish
  let n count fish
  let K-now random-triangle fish-carrying-capacity-mu (fish-carrying-capacity-rng * fish-carrying-capacity-mu)
  let births round(n * fish-growth-rate * (1 - n / K-now))
  ;; add fish if under carrying capacity
  if births > 0 [
    ask up-to-n-of births fish [ hatch 1 [
      set heading random-float 360
      ]
    ]
  ]
  ;; kill fish if beyond carrying capacity
  if births < 0 [
    ask up-to-n-of (-1 * births) fish [die]
  ]
end

;; grow the grain
to grow-grain
  ask patches with [zone = "Land"] [
    set since-harvest since-harvest + 1
    ;; set color to lime half way to harvest
    ifelse since-harvest >= land-yield-maturity-ticks [
      ;; set pcolor green
      set grain random-triangle land-yield-mu (land-yield-rng * land-yield-mu)
      let colorAdj 0
      if land-yield-rng > 0 [
        set colorAdj round((land-yield-mu - grain) / (2 * land-yield-rng * land-yield-mu)) * 2
      ]
      set pcolor 55 + colorAdj
    ]
    [
      if since-harvest > (land-yield-maturity-ticks / 2) [
        set pcolor lime
      ]
    ]
  ]
end

to-report getPeopleAtHomeList
  report map [ [v] -> getPeopleAtHome v ] sort villages
end

to-report getPeopleAtHome [thisVillage]
  let myCount 0
  ask thisVillage [
    set myCount count ourPeople with [patch-here = [patch-here] of thisVillage]
  ]
  report myCount
end]]></code>
  <widgets>
    <view x="368" wrappingAllowedX="false" y="10" frameRate="30.0" minPycor="0" height="668" showTickCounter="true" patchSize="13.0" fontSize="10" wrappingAllowedY="false" width="668" tickCounterLabel="ticks" maxPycor="50" updateMode="0" maxPxcor="50" minPxcor="0"></view>
    <button x="10" y="10" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="55">setup</button>
    <button x="70" y="10" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="55" display="step">go</button>
    <plot x="1045" autoPlotX="true" yMax="10.0" autoPlotY="true" y="10" xMin="0.0" height="175" legend="false" xMax="10.0" yMin="0.0" width="240" display="Fish Population">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="default" color="-16777216" legend="true">
        <setup></setup>
        <update>plot count fish</update>
      </pen>
    </plot>
    <button x="130" y="10" height="40" disableUntilTicks="false" forever="true" kind="Observer" width="55">go</button>
    <monitor x="1045" precision="17" y="190" height="60" fontSize="11" width="100">count fish</monitor>
    <note x="10" y="55" backgroundDark="0" fontSize="12" width="170" markdown="false" height="25" textColorDark="-1" textColorLight="-16777216" backgroundLight="0">Environmental Parameters</note>
    <slider x="10" step="1" y="85" max="500" width="225" display="fish-carrying-capacity-mu" height="50" min="0" direction="Horizontal" default="200.0" variable="fish-carrying-capacity-mu"></slider>
    <slider x="10" step="0.01" y="145" max="1" width="225" display="fish-carrying-capacity-rng" height="50" min="0" direction="Horizontal" default="0.0" variable="fish-carrying-capacity-rng"></slider>
    <slider x="10" step="0.01" y="205" max="0.25" width="225" display="fish-growth-rate" height="50" min="0" direction="Horizontal" default="0.1" variable="fish-growth-rate"></slider>
    <slider x="10" step="0.1" y="260" max="10" width="225" display="fish-tick-move-distance" height="50" min="0" direction="Horizontal" default="2.0" variable="fish-tick-move-distance"></slider>
    <slider x="10" step="0.1" y="315" max="10" width="225" display="land-yield-mu" height="50" min="0" direction="Horizontal" default="5.0" variable="land-yield-mu"></slider>
    <slider x="10" step="0.01" y="370" max="1" width="225" display="land-yield-rng" height="50" min="0" direction="Horizontal" default="0.0" variable="land-yield-rng"></slider>
    <slider x="10" step="1" y="425" max="30" width="225" display="land-yield-maturity-ticks" height="50" min="0" direction="Horizontal" default="10.0" variable="land-yield-maturity-ticks"></slider>
    <monitor x="1045" precision="17" y="285" height="60" fontSize="11" width="135" display="myJob"><![CDATA[map [ [t] -> [myJob] of t ] sort people]]></monitor>
    <monitor x="1045" precision="17" y="350" height="60" fontSize="11" width="135" display="myFish"><![CDATA[map [ [t] -> precision ([myFish] of t) 1 ] sort people]]></monitor>
    <monitor x="1045" precision="17" y="415" height="60" fontSize="11" width="135" display="myGrain"><![CDATA[map [ [t] -> precision ([myGrain] of t) 1 ] sort people]]></monitor>
    <monitor x="1045" precision="17" y="480" height="60" fontSize="11" width="135" display="myLeisureTicks"><![CDATA[map [ [t] -> [myLeisureTicks] of t ] sort people]]></monitor>
    <plot x="1185" autoPlotX="true" yMax="10.0" autoPlotY="true" y="285" xMin="0.0" height="255" legend="true" xMax="10.0" yMin="0.0" width="255" display="Village">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="ourFish" color="-13345367" legend="true">
        <setup></setup>
        <update>plot sum [ourFish] of villages</update>
      </pen>
      <pen interval="1.0" mode="0" display="ourGrain" color="-10899396" legend="true">
        <setup></setup>
        <update>plot sum [ourGrain] of villages</update>
      </pen>
      <pen interval="1.0" mode="0" display="myLeisureTicks" color="-5825686" legend="true">
        <setup></setup>
        <update>plot sum [ sum [ myLeisureTicks ] of myPeople ] of villages </update>
      </pen>
      <pen interval="1.0" mode="0" display="population" color="-2064490" legend="true">
        <setup></setup>
        <update>plot count people</update>
      </pen>
    </plot>
