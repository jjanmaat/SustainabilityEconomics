<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="true">
  <code><![CDATA[;; Landscape with water and land.  
;; Fish live in the water, reproducing according to standard logistic growth 
;; Land produces grain.  Grain must be gathered from patches.
;;
;; A couple is set up with a house somewhere on land.
;; There are two types that make up the couple, a gatherer and a hunter
;; The gatherer will have a comparative advantage in gathering
;; The hunter will have a comparative advantage in hunting - which here is fishing
;; The people need to consume a combination of fish and grain each tick to survive
;; Each type carries an inventory of fish and grain that they consume from each tick
;; The house has an inventory of fish and grain that the people contribute to and draw from
;; There will be a threshold level for the house inventory that triggers movement to gather or hunt

patches-own [ zone harvest-max since-harvest grain]
breed [ fish a-fish ]
breed [ people person ]
people-own [
  myFish         ;; fish person holds
  myGrain        ;; grain person holds
  myMaxFish      ;; maximum fish person can hold
  myMaxGrain     ;; maximum grain person can hold
  myFishHold     ;; fish person holds when at village
  myGrainHold    ;; grain person holds when at village
  myNeedFish     ;; fish per tick person needs to consume
  myNeedGrain    ;; grain per tick person needs to consume
  myMinRestTicks ;; minimum number of food ticks before I want to go back harvesting
  myMax-steps    ;; maximum steps person can take during a tick
  myNetRadius    ;; radius of fishing net
  myNet          ;; hold net patches while fishing
  myFishStepCost ;; cost, in steps, of pulling fish out of net
  myGrainStepCost ;; cost, in steps, for each unit of grain gathered
  myVillage      ;; village person is attached to
  myJob          ;; job person has - fish harvester or grain gatherer
  myLeisureTicks ;; sum of ticks when at home and not being sent out 
  goHome         ;; flag to indicate person is headed home
]
breed [ villages village ]
villages-own [
  ourFish        ;; fish in village inventory
  ourMinFishTicks ;; fish inventory measured in ticks comfy with
  ourGrain       ;; grain inventory in village
  ourMinGrainTicks ;; grain inventory measured in ticks comfy with
  myPeople       ;; people attached to this village
]

;; Setup global variables
globals [
  ;; carrying capacity follows a triangle distribution
  ;; fish-carrying-capacity-mu    ;; mean of fish carrying capacity
  ;; fish-carrying-capacity-rng   ;; range for fish carrying capacity distribution
  ;; fish-growth-rate
  ;; fish-tick-move-distance
  ;; land patch yield follows a triangle distribution
  ;; land-yield-mu                ;; mean of land yield
  ;; land-yield-rng               ;; range for land yield
  ;; land-yield-maturity-ticks    ;; ticks till land is mature after harvest
  ;; invent-fish-decay-mu         ;; mean decay rate for fish held in village inventory
  ;; invent-fish-decay-rng
  ;; invent-grain-decay-mu
  ;; invent-grain-decay-rng
  ;; invent-min-fish-ticks
  ;; invent-min-grain-ticks
  ;; people-max-steps
  ;; fish-net-radius-mu
  ;; fish-net-radius-rng
  ;; fish-take-step-cost-mu
  ;; fish-take-step-cost-rng
]

;; set default values
to defaults
  set-globals
end

;; Set values for globals
to set-globals 
  ;; set up fish ecology
  set fish-carrying-capacity-mu 200
  set fish-carrying-capacity-rng 0
  set fish-growth-rate 0.1
  set fish-tick-move-distance 2
  ;; set up land ecology
  set land-yield-mu 5
  set land-yield-rng 0
  set land-yield-maturity-ticks 10
  ;; set defaults for fisher
  set fisher-max-steps 5
  set fisher-grain-step-cost-mu 0.67
  set fisher-grain-step-cost-rng 0
  set fisher-fish-net-radius-mu 10
  set fisher-fish-net-radius-rng 0
  set fisher-fish-take-step-cost-mu 0.33
  set fisher-fish-take-step-cost-rng 0
  set fisher-fish-max-carry 30
  set fisher-grain-max-carry 100
  set fisher-fish-step-eat 1
  set fisher-grain-step-eat 5
  ;; set defaults for gatherer
  set gather-max-steps 5
  set gather-grain-step-cost-mu 0.33
  set gather-grain-step-cost-rng 0
  set gather-fish-net-radius-mu 5
  set gather-fish-net-radius-rng 0
  set gather-fish-take-step-cost-mu 0.67
  set gather-fish-take-step-cost-rng 0
  set gather-fish-max-carry 20
  set gather-grain-max-carry 200
  set gather-fish-step-eat 1
  set gather-grain-step-eat 5
  ;; set village defaults
  ;; set invent-min-fish-ticks 10
  ;; set invent-min-grain-ticks 10
  set village-population 2
  set village-share-fishing 0.5
  ;; set up inventory decay parameters
  set invent-fish-decay-mu 0
  set invent-fish-decay-rng 0
  set invent-grain-decay-mu 0
  set invent-grain-decay-rng 0
  ;; parameters specifying how many ticks worth of inventory desired in village
  ;; set invent-min-fish-ticks 10
  ;; set invent-min-grain-ticks 10
end

;; random draw from triangle distribution
to-report random-triangle [ 
  mu          ;; mean
  rng         ;; base width of triangle
]
  report mu + rng * (random-float 0.5 - random-float 0.5)
end

;; Setup

to setup
  clear-all
  clear-all-plots
  ;; set dimensions of world
  resize-world 0 50 0 50
  ;; set-globals ;; set global values
  ask patches [
    ifelse pxcor < 30
    [
      set zone "Land" 
      ;; set pcolor green
      set harvest-max 10
      set since-harvest land-yield-maturity-ticks
      set grain random-triangle land-yield-mu (land-yield-rng * land-yield-mu)
      let colorAdj 0
      if land-yield-rng > 0 [
        set colorAdj round((land-yield-mu - grain) / (2 * land-yield-rng * land-yield-mu)) * 2
        show (word "grain: " grain ", colorAdj: " colorAdj) 
      ]
      set pcolor 55 + colorAdj
    ]
    [
      set zone "Water" 
      set pcolor blue
      set harvest-max 0
    ]
  ]
  ;; initialize fish population
  setup-fish fish-carrying-capacity-mu / 2
  reset-ticks
  setup-village
  show "Done Setup"
end

;; get harvester location
to setup-village
  user-message "Please select a starting point on the landscape before proceeding."
  let placed false
  while [not placed] [
    ;; get mouse location if clicked
    if mouse-inside? and mouse-down? [
  let patchClicked patch mouse-xcor mouse-ycor
      ;; check that location is on land
      if [ zone ] of patchClicked = "Land" [
        create-villages 1 [
          move-to patchClicked
          set shape "house"
          set color yellow
          ;; set village starting values
          ;; set ourMinFishTicks 10
          ;; set ourMinGrainTicks 10
          ;; create people and add them to the village
          let parent self
          set myPeople []
          ;; let village-population 2
          let fisher-counter 0
          hatch village-population [
            set breed people
            move-to patchClicked
            set shape "person"
            set color red
            set myJob "Ga"
            set myVillage parent
            ; ifelse [fisher-counter] of parent < (village-population / 2) [
            ;   set myJob "Fi"
            ;   set fisher-counter fisher-counter + 1
            ; ]
            ; [ 
            ;   set myJob "Ga"
            ; ]
            ask parent [ 
              set myPeople (turtle-set myPeople myself) 
              set fisher-counter fisher-counter + 1
            ]
          ]
          ;; assign share of village people to fishing task
          ask n-of (round (village-population * village-share-fishing)) myPeople [
            set myJob "Fi"
          ]
          ;; set abilities of the two types, from random setting
          ask myPeople [
            ;; set the common stuff for all of them
            ;; set myNeedFish 1
            ;; set myNeedGrain 5
            ;; set myMaxFish 30
            ;; set myMaxGrain 200
            set myFishHold 10
            set myFish myFishHold
            set myGrainHold 50
            set myGrain myGrainHold
            ;; set myNetRadius 10
            ;; set myFishStepCost 0.33
            set myLeisureTicks 0
            set myNet no-patches
            set goHome true
            ;; set myMax-steps people-max-steps
            ;; set the stuff that is specific to the fishing type
            if myJob = "Fi" [
              set myNetRadius random-triangle fisher-fish-net-radius-mu (fisher-fish-net-radius-mu * fisher-fish-net-radius-rng)
              set myFishStepCost random-triangle fisher-fish-take-step-cost-mu (fisher-fish-take-step-cost-mu * fisher-fish-take-step-cost-rng)
              set myGrainStepCost random-triangle fisher-grain-step-cost-mu (fisher-grain-step-cost-mu * fisher-grain-step-cost-rng)
              set myMax-steps fisher-max-steps
              set myMaxFish fisher-fish-max-carry
              set myMaxGrain fisher-grain-max-carry
              set myNeedFish fisher-fish-step-eat
              set myNeedGrain fisher-grain-step-eat
              set myMinRestTicks fisher-min-rest-ticks
            ]
            ;; set the stuff that is specific to the gatherer type
            if myJob = "Ga" [
              set myNetRadius random-triangle gather-fish-net-radius-mu (gather-fish-net-radius-mu * gather-fish-net-radius-rng)
              set myFishStepCost random-triangle gather-fish-take-step-cost-mu (gather-fish-take-step-cost-mu * gather-fish-take-step-cost-rng)
              set myGrainStepCost random-triangle gather-grain-step-cost-mu (gather-grain-step-cost-mu * gather-grain-step-cost-rng)
              set myMax-steps gather-max-steps
              set myMaxFish gather-fish-max-carry
              set myMaxGrain gather-grain-max-carry
              set myNeedFish gather-fish-step-eat
              set myNeedGrain gather-grain-step-eat
              set myMinRestTicks gather-min-rest-ticks
            ]
          ]
          ;; clear out grain in spot where village is
          ask patchClicked [
            set grain 0
          ]
            ;; set village inventory at start enough to fill everyone's desired hold 
            set ourFish sum [myFishHold] of myPeople
            set ourGrain sum [myGrainHold] of myPeople
        ]          
        set placed true
      ]
    ]   
  ]
end

;; set fish numbers in water
to setup-fish [ n-fish ]
  create-fish n-fish [
    set shape "fish"
    set color red
    move-to one-of patches with [ zone = "Water" ]
    set heading random-float 360
  ]
end

;;***************************************************************************************************************
;; Go
to go
  move-fish 
  grow-fish
  grow-grain
  eat
  ;; go over every person
  ask villages [
    in-village self
    ask myPeople with [ myJob = "Fi" ][ harvest-fish self ]
    ask myPeople with [ myJob = "Ga" ][ gather-grain self ]
  ]
  tick
end
;;
;;**************************************************************************************************************

;; determine how many ticks we have enough food for in the 
;; village storage
to-report get-inventory-fish-ticks [ thisVillage ]
  let inventTicks 0
  ask thisVillage [
    if count myPeople > 0 [
      let sumNeedFish sum [myNeedFish] of myPeople
      set inventTicks int (ourFish / sumNeedFish)
    ]
  ]
  report inventTicks
end

;; determine how many ticks we have enough food for in the 
;; village storage
to-report get-inventory-grain-ticks [ thisVillage ]
  let inventTicks 0
  ask thisVillage [
    if count myPeople > 0 [
      let sumNeedGrain sum [myNeedGrain] of myPeople
      set inventTicks int (ourGrain / sumNeedGrain)
    ]
  ]
  report inventTicks
end

;; a function to get the life left, given the parameters
to-report getLifeLeft [ fishNow grainNow needFish needGrain ]
  report min list (fishNow / needFish) (grainNow / needGrain)
end

;; check how many ticks of life do I have with current personal inventory
to-report getMyLifeLeft
  report getLifeLeft myFish myGrain myNeedFish myNeedGrain
end

;; how much excess grain do I have
to-report getMyExcessGrain
  report min list (myNeedGrain * (myGrain / myNeedGrain - myFish / myNeedFish)) 0
end

;; how much excess fish do I have
to-report getMyExcessFish
  report min list (myNeedFish * (myFish / myNeedFish - myGrain / myNeedGrain)) 0
end

;; get the slope of the trading ratio for a diagonal across the core between the endowments in an edgeworth box
;; slope will be in the space of fish - how much grain traded per fish.
to-report getCoreSlope [ trader1 trader2 ]
  report (([myGrain] of trader1) - ([myGrain] of trader2)) / (([myFish] of trader1) - ([myFish] of trader2))
end

;; This has been informed by gemini.google.com
;; Let the untility function be the ticks of life that the trader has left
;; U1 = min(myFish1 / myNeedFish1, myGrain1 / myNeedGrain1)
;; U2 = min(myFish2 / myNeedFish2, myGrain2 / myNeedGrain2)
;;
;; Expressing this as a scaling parameter on fish, have
;; U1 = min((myNeedGrain1 / myNeedFish1) * myFish, myGrain1) / myNeedGrain1
;; U2 = ...
;;
;; The contract curve in the core is thick.  There are sets of points for any value of (myFish1 + myFish2) that
;; yield the same utility for different levels of (myGrain1 + myGrain2).  This results in a thick core.  
;; Changing (myFish1, myFish2) will make one trader better off and the other worse off.  However, changing
;; (myGrain1, myGrain2) will not affect eithet traders utility for this range.  The result is that for the 
;; region in the set of utility improving points - the lens - that are on the contract curve, utility
;; can be expressed using only one dimension.  In this case using myFish.  
;;
;; The procedure is
;; 1) find the corner points of the core, bottom right and top left
;; 2) find the line through these two points
;; 3) find the line between the two endowments
;; 4) find the intersection of these two lines
;; 5) check to see if this intersection is an improvement for both traders
;; 6) if it is an improvement, then make the trade happen
to-report tradeSolution [ trader1 trader2 ]
  show "**********"
  show ( word "trader1:" [who] of trader1 "," [myJob] of trader1 " trader2:" [who] of trader2 "," [myJob] of trader2)
  ;; endowments for the traders
  let fish1 [myFish] of trader1
  let fish2 [myFish] of trader2
  let grain1 [myGrain] of trader1
  let grain2 [myGrain] of trader2
  show (word "fish1:" fish1 " grain1:" grain1 " fish2:" fish2 " grain2:" grain2) 
  ;; get slope of Leontief ray for each trader
  let rayFish1 [myNeedGrain / myNeedFish] of trader1
  let rayFish2 [myNeedGrain / myNeedFish] of trader2
  show (word "rayFish1:" rayFish1 " rayFish2:" rayFish2)
  ;; get the utility for each trader at the endowment
  let utilTrader1 min list (rayFish1 * fish1) grain1
  let utilTrader2 min list (rayFish2 * fish2) grain2
  show (word "utilTrader1:" utilTrader1 " utilTrader2:" utilTrader2)
  ;; get the limits for the levels of fish within which any solution must lie
  let fishLB utilTrader1 / rayFish1
  let fishUB (fish1 + fish2) - (utilTrader2 / rayFish2)
  show (word "fishLB:" fishLB " fishUB:" fishUB)
  ;; get the value for fish that equates the gain in utility for each of the traders
  ;; Gain in utility for trader1 is rayFish1 * newFish1 - utilTrader1
  ;; Gain in utility for trader2 is rayFish2 * (fish1 + fish2 - newFish1) - utilTrader2
  ;; After some algebra
  ;; newFish1 = (rayFish2 * (fish1 + fish2) - utilTrader2 + utilTrader1) / (rayFish1 + rayFish2)
  let newFish1 (rayFish2 * (fish1 + fish2) - utilTrader2 + utilTrader1) / (rayFish1 + rayFish2)
  ;; At newFish1, there is likely a whole range of values for grain that have the same 
  ;; utility for both agent
  let newGrainLim1 rayFish1 * newFish1
  let newGrainLim2 (grain1 + grain2) - rayFish2 * (fish1 + fish2) + rayFish2 * newFish1
  ;; To simplify, pick the midpoint of this segemnt
  let newGrain1 (newGrainLim1 + newGrainLim2) / 2
  ;; Validity check, does the new point exist within the lens?
  if ((newFish1 < fishLB) or (newFish1 > fishUB)) [
    ;; the newFish is either below lower bound or above upper bound.  Set it equal to the original
    set newFish1 fish1
    set newGrain1 grain1
  ]
  let newFish2 (fish1 + fish2) - newFish1
  let newGrain2 (grain1 + grain2) - newGrain1
  show (word "newFish1:" newFish1 " newGrain1:" newGrain1 " newFish2:" newFish2 " newGrain2:" newGrain2) 
  ;; report the trade solution
  report (list newFish1 newGrain1 newFish2 newGrain2)
end

;; given two traders, return the life span increase if the trade occurs
to-report tradeLifeExtend [ trader1 trader2 ]
  ;;
  ;; get the trade solution
  let tradePlan tradeSolution trader1 trader2
  ;;
  ;; Check if at trade solution both traders can live longer than at their endowment
  let endowLife1 [getMyLifeLeft] of trader1
  let endowLife2 [getMyLifeLeft] of trader2
  let tradeLife1 getLifeLeft item 0 tradePlan item 1 tradePlan [myNeedFish] of trader1 [myNeedGrain] of trader1
  let tradeLife2 getLifeLeft item 2 tradePlan item 3 tradePlan [myNeedFish] of trader2 [myNeedGrain] of trader2
  ;;
  show (word "endowLife1:" endowLife1 " tradeLife1:" tradeLife1 " endowLife2:" endowLife2 " tradeLife2:" tradeLife2)
  report (list (tradeLife1 - endowLife1) (tradeLife2 - endowLife2))
end

to makeTrade [ trader1 trader2 ]
  ;;
  ;; get the trade solution
  show (word "Trading between " trader1 " and " trader2)
  let tradePlan tradeSolution trader1 trader2
  ask trader1 [ 
    set myFish item 0 tradePlan
    set myGrain item 1 tradePlan
  ]
  ask trader2 [
    set myFish item 2 tradePlan
    set myGrain item 3 tradePlan
  ]
end
;; 
;; do activity at home
;; if at home, adjust inventory so each person is holding inventory would start with if 
;; leaving on activity
;; check if number of ticks of village inventory less than resting ticks.  If it is, send 
;; out people who are at home for inventory with least ticks
to in-village [ thisVillage ]
  ask thisVillage [
    ;; get all people who are at home
    let peopleHere myPeople with [
      patch-here = [patch-here] of thisVillage
    ]
    ask peopleHere [
      show (word "self in peoleHere:" self)
      ;; get everyone else in the turtle set
      let othersHere peopleHere who-are-not self
      if any? othersHere [
        ;; there are other turtles.  Find the turtle with whom would get the longest life extension
        let tradeWith min-one-of othersHere [ 
          item 0 tradeLifeExtend self myself 
        ]
        ;; check that trade solution is not just endowment
        let tradePlan tradeSolution self tradeWith
        if not((myFish = item 0 tradePlan) and (myGrain = item 1 tradePlan)) [
          ;; trade is not endowment, do the trade
          makeTrade self tradeWith 
        ]
      ]
    ]
    ;;
    ;; Decay everybody's fish and grain
    ask peopleHere [
      ;; decay the fish and the grain
      ;; decay based on triangle distribution, where one end of distribution is no decay
      let fishDecay random-triangle invent-fish-decay-mu ((min list invent-fish-decay-mu ( 1 - invent-fish-decay-mu)) * invent-fish-decay-rng )
      set myFish myFish * (1 - fishDecay)
      let grainDecay random-triangle invent-grain-decay-mu ((min list invent-grain-decay-mu ( 1 - invent-grain-decay-mu)) * invent-grain-decay-rng )
      set myGrain myGrain * (1 - grainDecay)
      show (word "ID: " who "Decay Rates " fishDecay " " grainDecay )
      ;;
      ;; add to leisure, since I am here
      set myLeisureTicks myLeisureTicks + 1
    ]
    ;; 
    ;; check if I am happy to just stay here
    ;; This is actually complicated.  If I am running low on the thing I don't produce, should I wait until somebody else gets here, or go 
    ;; get more fish.
    ;; process.  Stay until life expectency below threshold.  If short on what I don't harvest, continue to wait for someone to come 
    ;; back and trade with.  If I am a fish harvester and I will die from lack of grain, stay in village and hope somebody with grain comes in time
    ask (peopleHere with [myJob = "Fi"]) [
      if getMyLifeLeft <= myMinRestTicks [
        ;; want to go
        if getMyExcessGrain > 0 [
          set goHome false
        ]
      ]
    ]
    ask (peopleHere with [myJob = "Ga"]) [
      if getMyLifeLeft <= myMinRestTicks [
        ;; want to go
        if getMyExcessFish > 0 [
          set goHome false
        ]
      ]
    ]
  ]
end

;; eat-food
;; each tick, people need to eat.  Amount need to eat set as owned variables 
to eat
  ask villages [
    ask myPeople [
      set myFish myFish - myNeedFish
      set myGrain myGrain - myNeedGrain
      if (myFish < 0) or (myGrain < 0) [die]
    ]
  ]
end

;; check to see how many ticks worth of food remaining
to-report get-food-ticks [ thisPerson ]
  report min list (int myFish / myNeedFish) (int myGrain / myNeedGrain)
end

;; check to see how many ticks needed to get home
to-report get-ticks-to-home [ thisPerson ] 
  report (distance myVillage / myMax-steps) + 1
end

;; harvest fish
;; each fish caught takes a time step.  Throwing the net takes one step.
to harvest-fish [ thisPerson ]
  ask thisPerson [
    ;; check if time to start heading for home
    if ((get-food-ticks self) - 1) < (get-ticks-to-home self) [
      set goHome true
    ]
    ;; check if they are going home
    ifelse goHome [
      ;; if going home, pull net if not already pulled
      if any? myNet [
        ask myNet [set pcolor blue]
        set myNet no-patches
        show "Pulling net"
      ]
      move-toward-village self
    ]
    [
      ifelse any? (neighbors with [ zone = "Water" ]) [
          ;; have a patch with water as a neighbour, so can harvest fish
        let steps-used 0
        ;; if necessary, cast the net
        if not any? myNet [
          ;; get the closest water patch
          let netCenter min-one-of patches with [ zone = "Water" ][distance thisPerson]
          set myNet ([patches in-radius ([myNetRadius] of thisPerson)] of netCenter) with [ zone = "Water" ]
          ask myNet [set pcolor cyan]
          set steps-used steps-used + 1
        ]          
        ;; pull as many fish out of the net as have energy for
        ;; get any fish that are in the net patches
        let inNet fish-on myNet
        let caughtFish up-to-n-of ((myMax-steps - steps-used) / myFishStepCost) inNet
        set myFish MyFish + count caughtFish
        set steps-used steps-used + count caughtFish
        ask caughtFish [ die ]
        show "Hauling in fish"
        ;; have we hit maximum fish?
        if myFish > myMaxFish [
          set goHome true
        ]
      ]
      [
        ;; no water in neighbourhood, so move toward shore
        move-toward-shore self
      ]
    ]
  ]
end
;; 
;; move a person agent toward shore
to move-toward-shore [ thisPerson ]
  ask thisPerson [
    if not any? (neighbors with [ zone = "Water" ]) [
      ;; get closest water patch
      let shore min-one-of patches with [ zone = "Water" ][distance thisPerson]
      if shore != nobody [
        face shore
        let steps-moved 0
        ;; move step by step until neighbour is water
        while [ steps-moved < myMax-steps and not any? (neighbors with [ zone = "Water" ])] [
          fd 1
          set steps-moved steps-moved + 1
          ;; should not be in the water, but might accidentally be
          if patch-here = shore [
            stop
          ]
        ]
      ]
    ]
  ]
end

;; move a person agent toward the house
to move-toward-village [ thisPerson ]
  ask thisPerson [
    ;; are we at the house?
    ifelse [patch-here] of thisPerson != [patch-here] of myVillage [
      ;; not at the house, so move toward house
      face myVillage
      let steps-moved 0
      while [ steps-moved < myMax-steps and ([patch-here] of thisPerson != [patch-here] of myVillage)] [
        fd 1
        set steps-moved steps-moved + 1
      ]
    ]
    [
      ;; at the village
      
    ]
  ]
end
  
;; move toward gathering spot
;; move in direction of neighborhood with the most food
;; move just one step.  This is called from the gathering process
to move-toward-grain [ thisPerson ]
  ask thisPerson [
    ;; find the neighboring patch with the most food in its neighbourhood
    let mostGrain max-one-of neighbors [
      grain + sum [grain] of neighbors 
    ]
    ;; point towards neighbour
    if mostGrain != nobody [
      face mostGrain
      forward 1
    ]
  ]
end

;; gather grain
;; gather grain proceeds by moving in the direction of grain until finding a patch with grain.
;; movement and harvesting continue until max step reached.  Each harvest counts as a step, as 
;; well as movement.
to gather-grain [ thisPerson ]
  ask thisPerson [
    ;; check if time to start heading for home
    if ((get-food-ticks self) - 1) < (get-ticks-to-home self) [
      set goHome true
    ]
    ;; check if going home
    ifelse goHome [
      move-toward-village self
    ]
    [
      let steps-used 0
      while [steps-used < myMax-steps] [
        ;; check if there is grain here to harvest
        if [grain] of patch-here > 0 [
          ;; harvest the grain from the patch
          ;; harvest four patches near to patch on
          let harvestPatches ( patch-set patch-here neighbors4 )
          let harvestGrain sum [grain] of harvestPatches
          set myGrain myGrain + harvestGrain
          ask harvestPatches [
            set grain 0
            set since-harvest 0
            set pcolor brown
          ]
          set steps-used steps-used + harvestGrain * myGrainStepCost
        ]
        ;; do we have any movement space left
        if steps-used < myMax-steps [
          ;; move one step in direction of most grain
          move-toward-grain self
          set steps-used steps-used + 1
        ]
      ]
      ;; check if have maximum grain
      if myGrain > myMaxGrain [set goHome true]
    ]
  ]
end

;; move fish
to move-fish
  ;; do a somewhat random walk for fish
  let fish-step fish-tick-move-distance
  ask fish [
    let ahead patch-ahead fish-step
    let flag true 
    while [flag] [
      if ahead != nobody [ 
        if [zone] of ahead = "Water" [
          set flag false
        ]
      ]
      let myDirection heading
      if flag [
        set myDirection myDirection + 150 + random-float 60
      ]
      set heading myDirection + random-float 45 - 22.5
      set ahead patch-ahead fish-step
    ]
    forward fish-step
  ]
end

;; grow fish
to grow-fish
  let n count fish
  let K-now random-triangle fish-carrying-capacity-mu (fish-carrying-capacity-rng * fish-carrying-capacity-mu)
  let births round(n * fish-growth-rate * (1 - n / K-now))
  ;; add fish if under carrying capacity
  if births > 0 [
    ask up-to-n-of births fish [ hatch 1 [
      set heading random-float 360
      ]
    ]
  ]
  ;; kill fish if beyond carrying capacity
  if births < 0 [
    ask up-to-n-of (-1 * births) fish [die]
  ]
end

;; grow the grain
to grow-grain
  ask patches with [zone = "Land"] [
    set since-harvest since-harvest + 1
    ;; set color to lime half way to harvest
    ifelse since-harvest >= land-yield-maturity-ticks [
      ;; set pcolor green
      set grain random-triangle land-yield-mu (land-yield-rng * land-yield-mu)
      let colorAdj 0
      if land-yield-rng > 0 [
        set colorAdj round((land-yield-mu - grain) / (2 * land-yield-rng * land-yield-mu)) * 2
      ]
      set pcolor 55 + colorAdj
    ]
    [
      if since-harvest > (land-yield-maturity-ticks / 2) [
        set pcolor lime
      ]
    ]
  ]
end]]></code>
