# "base"     "ASCnoDem" "ATRnoDem" "ASCnoLV"  "ATRnoLV"
ctrlNms <- c("ASCnoDem","ATRnoDem","ASCnoPC","ATRnoPC")
ctrlLst <- sapply(modsVec, function(modNm) {
mod <- modPE1resList[[modNm]]
c(ifelse(ctrlNms[1] %in% mod$restList, "", "Y"),
ifelse(ctrlNms[2] %in% mod$restList, "", "Y"),
ifelse(ctrlNms[3] %in% mod$restList, "", "Y"),
ifelse(ctrlNms[4] %in% mod$restList, "", "Y"))
})
ht <- add_rows(ht,as.data.frame(cbind(sub("no","*",ctrlNms),ctrlLst)))
ht <- theme_article(ht)
ht <- set_all_padding(ht,0)
caption(ht) <- "Random parameter estimates for ."
ht <- add_footnote(ht, "Significance levels: *** = 0.001, ** = 0.01, * = 0.05, + = 0.1")
ht
#
# Now create a huxtable where have ones with best AIC values and no significant
# loss of information
#
vecLRtest <- sapply(modPE1resList, function(mod) {mod$lrTest})
vecAIC <- sapply(modPE1resList, function(mod) {mod$model$AIC})
vecBIC <- sapply(modPE1resList, function(mod) {mod$model$BIC})
# #
# # Put stuff into the tables
# for(mod in modPE1resList) {
#   # Get restrictions as asc and atr parts
#   restList <- mod$restList
#   ascRst <- c("base",restList[grep("ASC",restList)])
#   atrRst <- c("base",restList[grep("ATR",restList)])
#   ascLab <- paste(rev(sort(ascRst)),collapse="_")
#   atrLab <- paste(rev(sort(atrRst)),collapse="_")
#   # print(c(ascLab,atrLab))
#   tabLRtest[ascLab,atrLab] <- mod$lrTest
#   tabAIC[ascLab,atrLab] <- mod$model$AIC
#   tabBIC[ascLab,atrLab] <- mod$model$BIC
#   # also just dump the stuff directly into a named vector
# }
# #
# Sort on AIC and examine others
o <- order(vecAIC)
dfOrd <- data.frame(AIC=vecAIC,BIC=vecBIC,LR=vecLRtest)[o,]
dfOrd <- dfOrd[row.names(dfOrd)!="base_base",]
#
# Eliminate models where P value of LR test less than 0.05
dfOrd <- cbind('Dem*ATR'=c("Y","")[grepl("ATRnoDem",row.names(dfOrd))+1],
'Dem*ASC'=c("Y","")[grepl("ASCnoDem",row.names(dfOrd))+1],
'M(ATR)'="",
'M(ASC)'="",
'Att*ATR'=c("Y","")[grepl("ATRnoPC",row.names(dfOrd))+1],
'Att*ASC'=c("Y","")[grepl("ASCnoPC",row.names(dfOrd))+1],
dfOrd)
#
# Table of test results for those that do not reject
# significant loss of information.
sel <- (dfOrd$LR>=0.05) | is.na(dfOrd$LR)
ht <- huxtable(dfOrd[sel,],add_colnames=TRUE)
number_format(ht)[,c("AIC","BIC")] <- "%4.0f"
number_format(ht)[,c("LR")] <- "%1.3f"
header_rows(ht)[1] <- TRUE
ht <- theme_article(ht)
caption(ht) <- "Model comparison results for estimations with first principle component.  Columns with \"Y\" indicate presence of interacted variable groups and random parameters.  \"Dem\" and \"Pc\" represent demographic and principle component and \"ATR\" and \"ASC\" represent choice experiment attributes and the alternative specific constant.  M(ATR) and M(ASC) models allow random parameters for the attribute and alternative specific constant influences."
htDirect <- ht
#
# Load models and generate table of results
load("HybridModels1.RData")
#
# Function to get vector of diagnostics from model
getDiag <- function(mdl) {
ret <- c(LLstart=ifelse(is.null(mdl$LLStart), NA, mdl$LLStart),
LLfinal=ifelse(is.null(mdl$finalLL), NA, mdl$finalLL),
LLsDep=last(mdl$LL0),
LLfDep=last(mdl$LLout),
Nobs=mdl$nObs,
Npar=mdl$numParams,
AIC=mdl$AIC,
BIC=mdl$BIC)
return(ret)
}
#
# Function to extract parameters, robust SE, and robust P-value from
# model parameters matrix
getPars <- function(mdl, prs) {
ret <- NULL
for(i in 1:length(prs)) {
if(prs[i] %in% rownames(mdl)) {
ret <- c(ret, mdl[prs[i],c("Estimate",'Rob.s.e.')],mdl[prs[i],ncol(mdl)])
} else {
ret <- c(ret,c(NA,NA,NA))
}
}
return(ret)
}
#
# Put together table of common parameters and diagnostics
parsVec <- c("asc_A","b_Wea","b_Spe","b_Nat","b_Lev","d_ascA_LV1","scl")
modsVec <- names(modLV1resList)
modsVec <- modsVec[nchar(modsVec)>0]
retTab <- sapply(modsVec, function(mod) {
modLst <- modLV1resList[[mod]]
c(getPars(modLst$modelOutput,parsVec),
getDiag(modLst$model),
lrTest=modLst$lrTest
)
})
#
retTab <- as.data.frame(retTab)
retTab <- cbind(c("ASC","","","Wea","","","Spe","","","Nat","","",
"Lev","","","ASC*LV","","","Scale","","",
"LL Start","LL Final","LLs Choice","LLf Choice",
"# Obs","# Pars","AIC","BIC","LR Test"),retTab)
colnames(retTab) <- c("","M1","M2","M3","M4","M5","M6","M7","M8","M9","M10")
# Substitute NA for estimate when parameters fixed
for(ni in 1:nrow(retTab)) {
nm <- rownames(retTab)[ni]
# print(nm)
if(substr(nm,1,7) == "Rob.s.e") {
retTab[ni-1,is.na(retTab[ni,])] <- NA
}
}
#
ht <- huxtable(retTab,add_colnames=TRUE)
for(i in 1:length(parsVec)) {
number_format(ht)[(i-1)*3+2,2:ncol(ht)] <-
paste('%5.3f',sig.stars(unlist(retTab[i*3,2:ncol(ht)])),sep="")
number_format(ht)[i*3,2:ncol(ht)] <- '(%2.3f)'
}
# Diagnostics formatting
numPars <- length(parsVec)
number_format(ht)[numPars*3+c(2:5,8:9),2:ncol(ht)] <- '%6.1f'
number_format(ht)[numPars*3+c(6:7),2:ncol(ht)] <- '%6.0f'
number_format(ht)[numPars*3+10,2:ncol(ht)] <- '%1.3f'
# Drop the p values
ht <- ht[c(1,
c(sapply(1:numPars,function(i) {(i-1)*3+2:3})),
(numPars*3+2):nrow(ht)),]
# Add indicators for other regressors
# "base"     "ASCnoDem" "ATRnoDem" "ASCnoLV"  "ATRnoLV"
ctrlNms <- c("ASCnoDem","ATRnoDem","ASCnoLV","ATRnoLV")
ctrlLst <- sapply(modsVec, function(modNm) {
mod <- modLV1resList[[modNm]]
c(ifelse(ctrlNms[1] %in% mod$restList, "", "Y"),
ifelse(ctrlNms[2] %in% mod$restList, "", "Y"),
ifelse(ctrlNms[3] %in% mod$restList, "", "Y"),
ifelse(ctrlNms[4] %in% mod$restList, "", "Y"))
})
ht <- add_rows(ht,as.data.frame(cbind(sub("no","*",ctrlNms),ctrlLst)))
ht <- theme_article(ht)
ht <- set_all_padding(ht,0)
caption(ht) <- "Random parameter estimates for ."
ht <- add_footnote(ht, "Significance levels: *** = 0.001, ** = 0.01, * = 0.05, + = 0.1")
ht
htLVset1 <- ht
#
LCF_LyXbits[['Table_LVmodels1']] <- ht
#
# Compare all the models in a results list
#
# Load models and generate table of results
if(!exists('modLV2resList')) load("HybridModels2.RData")
#
# Create lists with all possible combinations of models
modNames <- unique(unlist(lapply(modLV2resList, function(mod) {mod$restList})))
ascNames <- c("base",modNames[grep("ASC",modNames)])
atrNames <- c("base",modNames[grep("ATR",modNames)])
ascCombs <- unlist(lapply(1:length(ascNames), function(x) combn(rev(sort(ascNames)),x,simplify=FALSE)), recursive=FALSE)
atrCombs <- unlist(lapply(1:length(atrNames), function(x) combn(rev(sort(atrNames)),x,simplify=FALSE)), recursive=FALSE)
ascDimNms <- sapply(ascCombs, paste, collapse="_")
ascDimNms <- ascDimNms[grep("base",ascDimNms)]
atrDimNms <- sapply(atrCombs, paste, collapse="_")
atrDimNms <- atrDimNms[grep("base",atrDimNms)]
#
# create storage for LR test, AIC, and pseudo-R2
tabLRtest <- array(NA,dim=c(length(ascDimNms),length(atrDimNms)), dimnames=list(ascDimNms, atrDimNms))
tabAIC <- array(NA,dim=c(length(ascDimNms),length(atrDimNms)), dimnames=list(ascDimNms, atrDimNms))
tabBIC <- array(NA,dim=c(length(ascDimNms),length(atrDimNms)), dimnames=list(ascDimNms, atrDimNms))
#
vecLRtest <- sapply(modLV2resList, function(mod) {mod$lrTest})
vecAIC <- sapply(modLV2resList, function(mod) {mod$model$AIC})
vecBIC <- sapply(modLV2resList, function(mod) {mod$model$BIC})
#
# Put stuff into the tables
for(mod in modLV2resList) {
# Get restrictions as asc and atr parts
restList <- mod$restList
ascRst <- c("base",restList[grep("ASC",restList)])
atrRst <- c("base",restList[grep("ATR",restList)])
ascLab <- paste(rev(sort(ascRst)),collapse="_")
atrLab <- paste(rev(sort(atrRst)),collapse="_")
# print(c(ascLab,atrLab))
tabLRtest[ascLab,atrLab] <- mod$lrTest
tabAIC[ascLab,atrLab] <- mod$model$AIC
tabBIC[ascLab,atrLab] <- mod$model$BIC
# also just dump the stuff directly into a named vector
}
#
# Sort on AIC and examine others
o <- order(vecAIC)
dfOrd <- data.frame(AIC=vecAIC,BIC=vecBIC,LR=vecLRtest)[o,]
dfOrd <- dfOrd[row.names(dfOrd)!="base_base",]
#
# Eliminate models where P value of LR test less than 0.05
dfOrd <- cbind('Dem*ATR'=c("Y","")[grepl("ATRnoDem",row.names(dfOrd))+1],
'Dem*ASC'=c("Y","")[grepl("ASCnoDem",row.names(dfOrd))+1],
'M(ATR)'=c("Y","")[grepl("ATRnoMix",row.names(dfOrd))+1],
'M(ASC)'=c("Y","")[grepl("ASCnoMix",row.names(dfOrd))+1],
'Att*ATR'=c("Y","")[grepl("ATRnoLV",row.names(dfOrd))+1],
'Att*ASC'=c("Y","")[grepl("ASCnoLV",row.names(dfOrd))+1],
dfOrd)
#
# Table of test results for those that do not reject
# significant loss of information.
sel <- (dfOrd$LR>=0.05) | is.na(dfOrd$LR)
ht <- huxtable(dfOrd[sel,],add_colnames=TRUE)
number_format(ht)[,c("AIC","BIC")] <- "%4.0f"
number_format(ht)[,c("LR")] <- "%1.3f"
header_rows(ht)[1] <- TRUE
ht <- theme_article(ht)
caption(ht) <- "Model comparison results for estimations with latent variable.  Columns with \"Y\" indicate presence of interacted variable groups and random parameters.  \"Dem\" and \"Pc\" represent demographic and principle component and \"ATR\" and \"ASC\" represent choice experiment attributes and the alternative specific constant.  M(ATR) and M(ASC) models allow random parameters for the attribute and alternative specific constant influences."
htMixed <- ht
# ht
#
# To save space, put all the model comparison tests together into one
# table.
htDirect <- insert_row(htDirect,after=1,"First Principle Component",fill="",colspan=ncol(htDirect))
htMixed <- insert_row(htMixed,after=1,"Single Latent Variable",fill="",colspan=ncol(htMixed))
ht <- add_rows(htDirect,htMixed[2:nrow(ht),])
ht <- set_all_padding(ht,everywhere,everywhere,0)
header_rows(ht)[2:nrow(ht)] <- FALSE
ht <- theme_article(ht)
ht
#
LCF_LyXbits[['Table_CompareAll']] <- ht
#
# Construct a slim table comparing all the model estimations
if(!exists("modPC1resList")) load("DirectModels1.RData") # modPE1resList
# load("HybridModels1.RData") # modLV1resList
if(!exists("modLV2resList")) load("HybridModels2.RData") # modLV2resList
#
# Models to include, based on results of above analysis.  These are the
# models that have the smallest AIC, among models with non-significant LR
# test results.  Using direct, LV and LV mixed.
nmPC1 <- row.names(htDirect)[grep("base_",row.names(htDirect))][1]
nmLV1 <- row.names(htMixed)[grepl("base_",row.names(htMixed)) &
grepl("noMix",row.names(htMixed))][1]
nmLV2 <- row.names(htMixed)[grepl("base_",row.names(htMixed)) &
!grepl("noMix",row.names(htMixed))][1]
#
# Collect the results that will be put in table
coefTabPC0 <- modPE1resList[['base']]$modelOutput
coefTabPC1 <- modPE1resList[[nmPC1]]$modelOutput
coefTabLV0 <- modLV2resList[['base']]$modelOutput
coefTabLV1 <- modLV2resList[[nmLV1]]$modelOutput
coefTabLV2 <- modLV2resList[[nmLV2]]$modelOutput
#
# Adapt variable names in the PC model
PCnms <- rownames(coefTabPC1)
rpNms <- c("asc_A","b_Wea","b_Spe","b_Nat")
PCnms[PCnms %in% rpNms] <- paste("mu",PCnms[PCnms %in% rpNms],sep="_")
PCnms[PCnms=="d_ascA_AttPC1"] <- "d_ascA_LV1"
rownames(coefTabPC1) <- PCnms
rownames(coefTabPC0) <- PCnms
#
# Pull together table with estimates of interest
varNms <- c("mu_b_Wea","sd_b_Wea","mu_b_Spe","sd_b_Spe","mu_b_Nat","sd_b_Nat","b_Lev","mu_asc_A","sd_asc_A","d_ascA_LV1","scl")
resTab <- cbind(estCol(coefTabLV0,1,5,7,sderrBelow=T),
estCol(coefTabLV1,1,5,7,sderrBelow=T),
estCol(coefTabLV2,1,5,7,sderrBelow=T))
colnames(resTab) <- c("LV0","LV1","LV2")
resTab$PC0 <- NA
tmp <- estCol(coefTabPC0,1,5,7,sderrBelow=T)
resTab[row.names(tmp),"PC0"] <- tmp
resTab$PC1 <- NA
tmp <- estCol(coefTabPC1,1,5,7,sderrBelow=T)
resTab[row.names(tmp),"PC1"] <- tmp
#
# Create another table with the diagnostics
diagTab <- data.frame(PC0=getDiag(modPE1resList[['base']]$model),
PC1=getDiag(modPE1resList[[nmPC1]]$model),
LV0=getDiag(modLV2resList[['base']]$model),
LV1=getDiag(modLV2resList[[nmLV1]]$model),
LV2=getDiag(modLV2resList[[nmLV2]]$model))
diagTab <- rbind(diagTab,'P(LR)'=c(NA,modPE1resList[[nmPC1]]$lrTest,
NA,modLV2resList[[nmLV1]]$lrTest,
modLV2resList[[nmLV2]]$lrTest))
#
# Create a huxtable with the things of interest
htRows <- c(sapply(varNms,grep,x=row.names(resTab)))
htEst <- huxtable(resTab[htRows,c("PC0","PC1","LV0","LV1","LV2")],add_rownames=TRUE)
htEst[1,1] <- ""
htDiag <- huxtable(diagTab,add_rownames=TRUE)
number_format(htDiag)[c(2:5,8:9),2:ncol(htDiag)] <- "%.1f"
number_format(htDiag)[6:7,2:ncol(htDiag)] <- "%.0f"
htDiag[1,] <- ""
ht <- add_rows(htEst,htDiag)
ht <- set_all_padding(ht,everywhere,everywhere,0)
header_rows(ht)[1] <- TRUE
header_rows(ht)[2:nrow(ht)] <- FALSE
align(ht)[2:nrow(ht),2:ncol(ht)] <- '.'
ht <- theme_article(ht)
ht
#
LCF_LyXbits[['Table_BestModels']] <- ht
modLV2resList[[nmLV1]]$modelOutput
